{
  "name": "@workeryard/undershell",
  "version": "0.1.1",
  "description": "An SSH client for Cloudflare Workers: exec, shells, SFTP and jump hosts over any byte stream, with WebCrypto alone.",
  "type": "module",
  "license": "MIT",
  "author": "0x4d4d4f (https://github.com/0x4d4d4f)",
  "homepage": "https://github.com/workeryard/undershell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workeryard/undershell.git"
  },
  "bugs": {
    "url": "https://github.com/workeryard/undershell/issues"
  },
  "keywords": [
    "cloudflare-workers",
    "ssh",
    "sftp",
    "ssh-client",
    "workerd",
    "webcrypto",
    "jump-host",
    "cloudflare-tunnel"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./workers": "./src/workers/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "matrix": "tsx scripts/matrix.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "bcrypt-pbkdf": "^1.0.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
